# Supabase — get from https://supabase.com/dashboard/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Webhook secrets — generate strong random strings (e.g. openssl rand -hex 32)
MANYCHAT_WEBHOOK_SECRET=change-me-generate-strong-secret
CALENDLY_WEBHOOK_SECRET=change-me-generate-strong-secret

# Calendly API — get from https://calendly.com/integrations/api_webhooks
CALENDLY_API_KEY=your-calendly-personal-access-token

# Si está seteada, el webhook de Calendly SOLO procesa eventos cuyo host
# coincida con esta URI. Vacía = procesa todos los eventos de la org.
# Para obtener la URI: curl /users/me o /organization_memberships
CALENDLY_TRACKED_USER_URI=

# Vercel Cron secret — for /api/cron/* endpoints
CRON_SECRET=change-me-generate-strong-secret

# App URL (used for webhook URLs and absolute links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dev mode: si está en "true", saltea el login y deja navegar como Dev Admin.
# Útil para preview sin configurar auth. POR DEFECTO debería estar en "false".
NEXT_PUBLIC_DEV_BYPASS_AUTH=false
